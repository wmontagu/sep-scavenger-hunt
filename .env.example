# Copy this file to .env.local for local dev:   cp .env.example .env.local
# On a host (Railway, Vercel, ...) set the same names in its "Variables" / "Environment Variables" page.
# Never commit .env.local or real values. This file is the public template.
# Works on any Node host. Railway is the easiest because the app is stateful (needs Redis).

# REQUIRED: passcode for the exec console (/exec), /api/complete and reset. Pick something pledges won't guess.
EXEC_PASSCODE=change-me

# Storage.
# Unset = JSON file at .data/hunt.json (fine locally; wiped on every redeploy, and does NOT work on Vercel).
# Set REDIS_URL for any real event. Railway: add the Redis plugin and use ${{Redis.REDIS_URL}}.
# Vercel / others: a free Upstash or Redis Cloud URL, e.g. rediss://default:PASSWORD@HOST:PORT
REDIS_URL=

# Photo check for stage 7b: auto | claude | jev | manual   (auto = claude if key set, else jev, else manual)
IMAGE_VERIFIER=manual
ANTHROPIC_API_KEY=
# CLAUDE_VISION_MODEL=claude-opus-5-5
# Hard cap on paid classifier calls per hunt run (reset refills it); after that photos go to /exec.
# IMAGE_MAX_AI_CALLS=40
# Send "no" verdicts to an exec instead of rejecting outright (fewer false negatives):
# IMAGE_NO_GOES_TO_MANUAL=true

# Optional: Slack or Discord webhook for advisor pings + photos needing review.
EXEC_WEBHOOK_URL=

# Optional: whole answers.json as one JSON string; overrides content/answers.json.
# HUNT_ANSWERS_JSON=
