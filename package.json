{
  "name": "sep-scavenger-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-content": "tsx scripts/check-content.ts",
    "check-bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check-bundle",
    "reset": "tsx scripts/reset.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "build-docs": "python scripts/build_docs.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "ioredis": "^6.0.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
